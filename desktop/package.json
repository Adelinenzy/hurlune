{
  "name": "hurlune",
  "productName": "Hurlune",
  "version": "1.3.1",
  "description": "Loups-Garous entre amis — chat traduisible FR/RU",
  "main": "main.js",
  "author": "Adelinenzy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.hurlune.app",
    "productName": "Hurlune",
    "files": [
      "main.js",
      "preload.js",
      "proxy.json",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hurlune utilise le micro pour le chat vocal entre joueurs."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "artifactName": "Hurlune-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png"
  }
}
